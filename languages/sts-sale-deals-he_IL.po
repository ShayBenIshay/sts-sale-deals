msgid "Sale Deals"
msgstr "מבצעים"

msgid "Sale Deal"
msgstr "מבצע"

msgid "All deals"
msgstr "כל המבצעים"

msgid "Edit deal"
msgstr "עריכת מבצע"

msgid "View deal"
msgstr "הצגת מבצע"

msgid "Update deal"
msgstr "עדכון מבצע"

msgid "Add new deal"
msgstr "הוספת מבצע חדש"

msgid "New deal name"
msgstr "שם המבצע החדש"

msgid "Search deals"
msgstr "חיפוש מבצעים"

msgid "No deals found"
msgstr "לא נמצאו מבצעים"

msgid "Label text"
msgstr "טקסט התווית"

msgid "Shown on the product, e.g. \"3 for 10\". Leave empty to use the deal name."
msgstr "יוצג על המוצר, למשל \"3 ב־10\". אם השדה ריק, יוצג שם המבצע."

msgid "Label colour"
msgstr "צבע התווית"

msgid "Text colour"
msgstr "צבע הטקסט"

msgid "Show tag icon"
msgstr "הצגת אייקון תווית"

msgid "Image badge (optional, replaces the text pill)"
msgstr "תווית כתמונה (לא חובה, מחליפה את התווית הטקסטואלית)"

msgid "Choose image"
msgstr "בחירת תמונה"

msgid "Remove"
msgstr "הסרה"

msgid "Label design"
msgstr "עיצוב התווית"

msgid "Convert tags to deals"
msgstr "המרת תגיות למבצעים"

msgid "Tags to deals"
msgstr "תגיות למבצעים"

msgid "Convert product tags to deals"
msgstr "המרת תגיות מוצרים למבצעים"

msgid "%d deal(s) created or updated. Edit them under Products > Sale Deals."
msgstr "נוצרו או עודכנו %d מבצעים. אפשר לערוך אותם תחת מוצרים ← מבצעים."

msgid "Tick the tags that are sale deals. Each becomes a deal with the same slug, and every product with the tag is added to it. The tags are left untouched. You can edit the label afterwards."
msgstr "מסמנים את התגיות שהן מבצעים. כל תגית הופכת למבצע עם אותו מזהה, וכל מוצר עם התגית מתווסף אליו. התגיות עצמן לא משתנות. את התווית אפשר לערוך אחר כך."

msgid "Tag"
msgstr "תגית"

msgid "Products"
msgstr "מוצרים"

msgid "Label text (optional)"
msgstr "טקסט התווית (לא חובה)"

msgid "No product tags found."
msgstr "לא נמצאו תגיות מוצרים."

msgid "Convert selected tags"
msgstr "המרת התגיות שנבחרו"

msgid "Not allowed."
msgstr "אין הרשאה."

msgid "Sales"
msgstr "מבצעים"

msgid "Sale deals"
msgstr "מבצעים"

msgid "All sales"
msgstr "כל המבצעים"

msgid "There are no products in this deal right now."
msgstr "אין כרגע מוצרים במבצע הזה."

